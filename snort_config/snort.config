preprocessor frag3_global
preprocessor frag3_engine

alert tcp any any -> 10.0.0.2 :1023 (msg: “Limite de 20 ligacoes TPC excedido!”; sid:1; threshold: type both, track by_dst, count 20, seconds 60;)

alert tcp any any -> 10.0.0.2 22345 (msg: “Limite de 3 ligacoes para SpertaServer excedido!”; sid:2; threshold: type both, track by_src, count 3, seconds 20;)

alert tcp !10.0.1.0/24 any -> 10.0.0.2 22345 (msg: “Tentativa de acesso ao servidor fora da subrede dos clientes!”; sid: 3;)

alert icmp any any -> 10.0.0.2 any (msg: “Limite de 4 pings/sec excedido!”; sid: 4; threshold: type both, track by_dst, count 4, seconds 1;)


